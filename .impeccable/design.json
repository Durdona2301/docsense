  "narrative": {
    "northStar": "The Clear Evidence Workspace",
    "overview": "DocSense uses the user-selected conventional white-and-blue product interface: a white reading field, a cool pale-gray library, saturated blue actions and self-hosted humanist sans typography. Hairline boundaries and gently rounded controls make the workspace feel direct and familiar.\n\nThe visual emphasis belongs to questions, readable results and inspectable passages. Typography and pale tonal panels provide hierarchy; outline SVG icons support actions without competing with the text.",
    "keyCharacteristics": [
      "White reading surfaces with cool neutral support regions.",
      "Blue for primary actions, interaction and evidence emphasis.",
      "One self-hosted type family with strong headings and generous reading leading.",
      "Fine borders, restrained rounding and state-driven shadows."
    ],
    "rules": [
      {
        "name": "The Action Accent Rule",
        "body": "Use saturated blue to identify actions and interactive evidence; use pale blue for broad emphasis surfaces.",
        "section": "colors"
      },
      {
        "name": "The State Depth Rule",
        "body": "Keep ordinary surfaces flat; reserve the observed soft shadows for input focus and evidence focus.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use self-hosted Manrope for display and body text.",
      "Do use pale surfaces and fine borders to structure reading regions.",
      "Do keep citation focus visible and preserve readable, wrapping source text.",
      "Do collapse the workspace into a coherent single-column reading flow on phones.",
      "Do retain visible keyboard focus and respect reduced motion."
    ],
    "donts": [
      "Don't apply persistent decorative shadows to ordinary cards.",
      "Don't use saturated blue as the general reading background.",
      "Don't substitute glyph characters for the implemented outline SVG icons.",
      "Don't promote isolated metadata sizes into the shared typography scale."
    ]
  }
}
